{
  "name": "rail-refuge",
  "version": "1.0.3",
  "description": "Rail Refuge: High Tide Rising - A tower defense game about saving endangered Ridgway's Rails during king tides",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "npx eslint src",
    "android:icons": "python3 scripts/generate-android-icons.py",
    "android:sync": "npm run build && npm run android:icons && npx cap sync android",
    "android:build": "npm run android:sync && (cd android && ./gradlew assembleDebug)",
    "android:open": "npx cap open android"
  },
  "keywords": [
    "phaser",
    "game",
    "conservation",
    "rails",
    "tower-defense"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@fontsource/mona-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "lucide": "^1.43.0",
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "^5.0.0"
  }
}
